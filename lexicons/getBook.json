{
  "lexicon": 1,
  "id": "buzz.bookhive.getBook",
  "defs": {
    "progressHistoryEntry": {
      "type": "object",
      "required": ["createdAt"],
      "properties": {
        "createdAt": { "type": "string", "format": "datetime" },
        "currentPage": { "type": "integer" },
        "totalPages": { "type": "integer" },
        "percent": { "type": "integer" }
      }
    },
    "shelfMembership": {
      "type": "object",
      "required": ["uri", "name", "userDid", "itemUri"],
      "properties": {
        "uri": { "type": "string", "description": "AT-URI of the public catalogue shelf" },
        "name": { "type": "string" },
        "userDid": { "type": "string", "description": "DID of the shelf owner" },
        "itemUri": { "type": "string", "description": "AT-URI of the shelf's book-list item" }
      }
    },
    "main": {
      "type": "query",
      "description": "Get a book's info. Does not require authentication.",
      "parameters": {
        "type": "params",
        "properties": {
          "id": {
            "type": "string",
            "description": "The book's hive ID"
          },
          "isbn10": {
            "type": "string",
            "description": "The book ISBN-10 identifier"
          },
          "isbn13": {
            "type": "string",
            "description": "The book ISBN-13 identifier"
          },
          "goodreadsId": {
            "type": "string",
            "description": "The Goodreads identifier for the book"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["book", "reviews", "comments"],
          "properties": {
            "createdAt": {
              "type": "string",
              "format": "datetime"
            },
            "startedAt": {
              "type": "string",
              "format": "datetime",
              "description": "The date the user started reading the book"
            },
            "finishedAt": {
              "type": "string",
              "format": "datetime",
              "description": "The date the user finished reading the book"
            },
            "cover": {
              "type": "blob",
              "description": "Cover image of the book",
              "accept": ["image/png", "image/jpeg"],
              "maxSize": 1000000
            },
            "status": {
              "type": "string",
              "knownValues": [
                "buzz.bookhive.defs#finished",
                "buzz.bookhive.defs#reading",
                "buzz.bookhive.defs#wantToRead",
                "buzz.bookhive.defs#abandoned"
              ]
            },
            "owned": {
              "type": "boolean",
              "description": "Whether the user owns this book"
            },
            "stars": {
              "type": "integer",
              "description": "Number of stars given to the book (1-10) which will be mapped to 1-5 stars",
              "minimum": 1,
              "maximum": 10
            },
            "review": {
              "type": "string",
              "description": "The book's review",
              "maxGraphemes": 15000
            },
            "bookProgress": {
              "description": "Reading progress for the user",
              "type": "ref",
              "ref": "buzz.bookhive.defs#bookProgress"
            },
            "previousReads": {
              "type": "array",
              "description": "History of prior reads of this book by the user (most recent first)",
              "items": { "type": "ref", "ref": "buzz.bookhive.defs#previousRead" },
              "maxLength": 50
            },
            "progressHistory": {
              "type": "array",
              "description": "The authenticated viewer's latest 20 progress entries for this book, newest first. Omitted when signed out; unknown page/count/percent values are omitted.",
              "items": { "type": "ref", "ref": "#progressHistoryEntry" },
              "maxLength": 20
            },
            "shelves": {
              "type": "array",
              "description": "Public catalogue shelves containing this book, including the viewer's and other readers' shelves. Omitted when signed out. Never includes private ebook shelves.",
              "items": { "type": "ref", "ref": "#shelfMembership" }
            },
            "book": {
              "description": "The hive book's info",
              "type": "ref",
              "ref": "buzz.bookhive.hiveBook#main"
            },
            "reviews": {
              "description": "Reviews of the book",
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "buzz.bookhive.defs#review"
              }
            },
            "comments": {
              "description": "Comments on the book",
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "buzz.bookhive.defs#comment"
              }
            },
            "activity": {
              "description": "Other users' activity on the book",
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "buzz.bookhive.defs#activity"
              }
            }
          }
        }
      }
    }
  }
}
