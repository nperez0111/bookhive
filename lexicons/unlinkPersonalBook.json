{
  "lexicon": 1,
  "id": "buzz.bookhive.unlinkPersonalBook",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Unlink a personal library book from its BookHive catalog entry.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["contentHash"],
          "properties": {
            "contentHash": {
              "type": "string",
              "description": "SHA-256 hash of the file content"
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["book"],
          "properties": {
            "book": {
              "type": "ref",
              "ref": "buzz.bookhive.getPersonalLibrary#personalBookView"
            }
          }
        }
      }
    }
  }
}
