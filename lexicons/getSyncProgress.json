{
  "lexicon": 1,
  "id": "buzz.bookhive.getSyncProgress",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get reading sync progress for a document. Returns the KOSync-compatible progress data.",
      "parameters": {
        "type": "params",
        "required": ["contentHash"],
        "properties": {
          "contentHash": {
            "type": "string",
            "description": "Content hash identifying the document"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["document", "progress", "percentage", "device", "device_id", "timestamp"],
          "properties": {
            "document": {
              "type": "string",
              "description": "Document identifier"
            },
            "progress": {
              "type": "string",
              "description": "Reading progress position (KOSync format)"
            },
            "percentage": {
              "type": "string",
              "description": "Reading progress as a decimal string (0-1, e.g. '0.42')"
            },
            "device": {
              "type": "string",
              "description": "Device name that last synced"
            },
            "device_id": {
              "type": "string",
              "description": "Device identifier that last synced"
            },
            "timestamp": {
              "type": "integer",
              "description": "Unix timestamp of last sync"
            }
          }
        }
      }
    }
  }
}
