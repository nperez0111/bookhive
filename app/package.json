{
  "name": "bookhive-app",
  "version": "1.3.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:run": "jest --ci --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "export:check": "expo export --platform ios --platform android --output-dir dist/check",
    "update:staging": "bunx eas-cli@25.3.0 update --branch staging",
    "update:production": "bunx eas-cli@25.3.0 update --branch production",
    "update:development": "bunx eas-cli@25.3.0 update --branch development",
    "ios:build": "EAS_BUILD_NO_EXPO_GO_WARNING=true bunx eas-cli@25.3.0 build --platform ios",
    "ios:submit": "bunx eas-cli@25.3.0 submit --platform ios",
    "android:build": "EAS_BUILD_NO_EXPO_GO_WARNING=true bunx eas-cli@25.3.0 build --platform android",
    "android:submit": "bunx eas-cli@25.3.0 submit --platform android",
    "bump": "bun run scripts/bump-version.ts"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "5.100.10",
    "@tanstack/react-query": "5.100.10",
    "@tanstack/react-query-persist-client": "5.100.10",
    "date-fns": "4.1.0",
    "expo": "57.0.31",
    "expo-application": "57.0.3",
    "expo-blur": "57.0.3",
    "expo-clipboard": "57.0.2",
    "expo-constants": "57.0.22",
    "expo-dev-client": "57.0.20",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-haptics": "57.0.3",
    "expo-linear-gradient": "57.0.2",
    "expo-linking": "57.0.13",
    "expo-router": "57.0.29",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.24",
    "expo-splash-screen": "57.0.10",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.3",
    "expo-system-ui": "57.0.4",
    "expo-updates": "57.0.26",
    "expo-web-browser": "57.0.3",
    "ofetch": "1.5.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.6",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.14",
    "babel-preset-expo": "57.0.16",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  }
}
