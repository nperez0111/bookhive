{
  "name": "bookhive-app",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:run": "jest --ci --runInBand",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "export:check": "expo export --platform ios --platform android --output-dir dist/check",
    "update:staging": "bunx eas-cli@27.10.0 update --branch staging",
    "update:production": "bunx eas-cli@27.10.0 update --branch production",
    "update:development": "bunx eas-cli@27.10.0 update --branch development",
    "ios:build": "EAS_BUILD_NO_EXPO_GO_WARNING=true bunx eas-cli@27.10.0 build --platform ios",
    "ios:submit": "bunx eas-cli@27.10.0 submit --platform ios",
    "android:build": "EAS_BUILD_NO_EXPO_GO_WARNING=true bunx eas-cli@27.10.0 build --platform android",
    "android:submit": "bunx eas-cli@27.10.0 submit --platform android",
    "bump": "bun run scripts/bump-version.ts"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@expo/vector-icons": "15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "5.100.10",
    "@tanstack/react-query": "5.100.10",
    "@tanstack/react-query-persist-client": "5.100.10",
    "date-fns": "4.1.0",
    "expo": "58.0.25",
    "expo-application": "58.1.2",
    "expo-blur": "58.0.6",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.16",
    "expo-dev-client": "58.0.20",
    "expo-document-picker": "58.0.5",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.12",
    "expo-haptics": "58.0.8",
    "expo-linear-gradient": "58.0.4",
    "expo-linking": "58.0.17",
    "expo-router": "58.0.31",
    "expo-secure-store": "58.0.3",
    "expo-sharing": "58.0.23",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "expo-symbols": "58.0.5",
    "expo-system-ui": "58.0.7",
    "expo-updates": "58.0.22",
    "expo-web-browser": "58.0.8",
    "ofetch": "1.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.25",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  }
}
