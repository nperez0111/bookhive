{
  "expo": {
    "name": "bookhive",
    "slug": "bookhive",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookhive",
    "userInterfaceStyle": "automatic",
    "githubUrl": "https://github.com/nperez0111/bookhive",
    "ios": {
      "icon": "./assets/images/icon.icon",
      "supportsTablet": true,
      "bundleIdentifier": "buzz.bookhive.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": true
      },
      "buildNumber": "20000"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "buzz.bookhive.app",
      "versionCode": 20000
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/bee.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#f9eabc",
          "dark": {
            "image": "./assets/images/bee.png",
            "backgroundColor": "#271e19"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      [
        "expo-updates",
        {
          "username": "nickthesick"
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e5bb0612-33b8-4bfd-8ae4-b37fe1b82a3b"
      }
    },
    "owner": "nickthesick",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e5bb0612-33b8-4bfd-8ae4-b37fe1b82a3b"
    }
  }
}
